# Copy to .env for local runs (never commit .env). In GitHub Actions,
# set these under Settings -> Secrets and variables -> Actions.

# --- Secrets ---
# The mailbox that receives the journalist-request digests (Gmail with an app password)
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Configuration (optional) ---
# Drafts are saved for review by default. Set to true to send pitches automatically.
AUTO_SEND=false
PITCH_LIMIT=5
# Folder searched for digests
HARO_MAILBOX=[Gmail]/All Mail
# REPLY_TO=alex@acmesupply.example
CLAUDE_MODEL=claude-haiku-4-5-20251001
# CONFIG_DIR=./config
# STATE_DIR=./state
